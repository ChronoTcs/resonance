# Android Release Keystore Configuration Example
# To enable release signing:
# 1. Copy this file to "key.properties" in this directory (android/key.properties).
# 2. Fill in the values below corresponding to your release keystore.
# 3. "key.properties" and "*.keystore" / "*.jks" are already in .gitignore to protect your keys.

storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=your_key_alias
storeFile=../upload-keystore.jks
